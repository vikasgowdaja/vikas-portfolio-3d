# Frontend
VITE_API_BASE_URL=http://localhost:5000

# Backend
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority
# Optional fallback when SRV DNS is blocked by network/hosting
MONGODB_URI_DIRECT=mongodb://<host1>:27017,<host2>:27017,<host3>:27017/<db-name>?replicaSet=<replica-set>&ssl=true&authSource=admin&retryWrites=true&w=majority
# Optional custom DNS resolvers for Node runtime
DNS_SERVERS=1.1.1.1,8.8.8.8
CLIENT_ORIGIN=http://localhost:5173
